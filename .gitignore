# ═══════════════════════════════════════════════════════════════
#  ARES — .gitignore
#  Note: adding a pattern here does NOT untrack files git already
#  tracks. It only stops NEW ones. To untrack something already
#  committed:  git rm --cached <path>
# ═══════════════════════════════════════════════════════════════

# ── Model weights and exports ──────────────────────────────────
# Weights do not belong in git. Git stores every version forever,
# so a 22 MB checkpoint committed five times is 110 MB of history
# that can never be reclaimed without rewriting the repo.
# Publish weights as GitHub Release assets instead.
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.mlmodel
*.mlpackage
*_ncnn_model/
*_openvino_model/
*_saved_model/

# ── Datasets and media ─────────────────────────────────────────
# C2A, VisDrone, AIDER and demo footage are downloaded, not stored.
datasets/
data/raw/
data/interim/
*.mp4
*.avi
*.mov
*.mkv
!docs/**/*.mp4

# Detection output — regenerated by running the model
detections*.json
!**/fixture_detections.json

# Cached OpenStreetMap tiles — downloaded by tools/fetch_tiles.py, not
# authored. A few hundred PNGs that git would keep forever, re-fetchable
# in a few minutes, and OSM's data rather than ours to redistribute.
backend/data/tiles/

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
ares-env/

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ── Node / frontend ────────────────────────────────────────────
# The single most important block here. node_modules is ~200 MB
# and would dwarf everything else in this repo.
node_modules/
frontend/dist/
frontend/.vite/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Ultralytics run artifacts ──────────────────────────────────
runs/
wandb/
yolo*.pt
*.cache

# ── Environment and secrets ────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Editors and OS ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ── Claude Code ────────────────────────────────────────────────
# Keep CLAUDE.md tracked — it is shared context.
# Ignore only per-machine local settings.
.claude/settings.local.json
frontend/public/demo_clip.mp4
.venv/
